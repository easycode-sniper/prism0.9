{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/site-test-trigger.sh\"",
            "if": "Bash(git *)",
            "timeout": 15,
            "statusMessage": "Checking whether the deployed site needs a test"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(node --experimental-strip-types scripts/site-test.mts:*)"
    ]
  }
}
