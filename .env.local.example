# Prism — Supabase environment variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to the repo.

# Supabase project URL (from project dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://znaebnyvlbycalawfnhu.supabase.co

# Anon key (from Settings → API → anon public key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key (from Settings → API → service_role key)
# Used only in server-side admin operations. NEVER exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Shared secret for the scheduled monitoring endpoint (/api/tick).
# pg_cron in Supabase sends this as the x-cron-secret header; without a
# match the route returns 401. Store the same value in Supabase Vault as
# "fleet_tick_secret" — see supabase/migrations/014_scheduled_fleet_tick.sql.
CRON_SECRET=

# CARTO Basemaps API key, for the Leaflet dark/light basemap tiles.
# CARTO began requiring one in August 2026; without it every tile is
# stamped "API KEY REQUIRED". Request one at
# https://carto.com/basemaps — they email it to you.
#
# NEXT_PUBLIC_ is correct and not an oversight: Leaflet builds the tile
# URLs in the browser, so this value is visible in the network tab by
# design, which is what a basemap key is. It lives in the environment
# rather than in the source because THIS REPOSITORY IS PUBLIC, and a key
# committed to a public repo gets scraped and its quota spent by
# strangers. Set it in Vercel → Settings → Environment Variables too, or
# production keeps the watermark.
NEXT_PUBLIC_CARTO_BASEMAP_KEY=

# Sign-in used by scripts/site-test.mts and the site-tester agent, which
# log in to the deployed site as a real user and walk every route. Any
# account with access works; a dedicated low-privilege one is better than
# your own. These live only in .env.local — THIS REPOSITORY IS PUBLIC, and
# a password committed to a public repo is a password you have given away.
PRISM_TEST_EMAIL=
PRISM_TEST_PASSWORD=

# Optional. Override the target (a preview deployment, or a local server).
# Defaults to https://prism0-9.vercel.app.
# PRISM_TEST_URL=

# Optional. Chromium binary, when not the sandbox's /opt/pw-browsers/chromium.
# PRISM_TEST_CHROMIUM=

# ── Blacklisted-station email alerts ──────────────────────────────────
# When a truck STOPS at a station on the blacklist, Prism writes the
# usual in-app notification and also emails it, because that alert is
# only useful while the truck is still on the forecourt and nobody is
# watching the screen at 06:00.
#
# Leave these unset and nothing breaks: the tick reports "email skipped:
# not configured (...)" in its warnings and the in-app alert is
# unaffected. The app is the system of record; the email is a copy.
#
# Set them in Vercel → Settings → Environment Variables too, or only
# local runs send anything. NEVER commit the password — THIS REPOSITORY
# IS PUBLIC.
#
# Host and port for the mailbox the alert is sent FROM. 587 is STARTTLS
# (Microsoft 365, Google Workspace) and 465 is implicit TLS; the code
# picks the right mode from the port, and getting the pair wrong is the
# usual reason a send hangs rather than failing.
#   Microsoft 365   smtp.office365.com    587
#   Google Workspace smtp.gmail.com       587
#   cPanel / shared  mail.omd-dz.com      465
SMTP_HOST=
SMTP_PORT=587

# The mailbox to authenticate as. On Google Workspace with 2FA, and on
# Microsoft 365 with modern auth enforced, this must be an APP PASSWORD
# rather than the account's own password.
SMTP_USER=
SMTP_PASSWORD=

# Who the alert goes to. Comma-separated for more than one.
ALERT_EMAIL_TO=service.carburant.omd@omd-dz.com

# Optional. Defaults to SMTP_USER, because most providers refuse a From
# that is not the authenticated mailbox or a configured alias of it.
# ALERT_EMAIL_FROM=Prism Alerts <alerts@omd-dz.com>
